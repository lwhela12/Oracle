GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ANU Quantum Numbers: paid subscription billed through AWS Marketplace.
# Set as a Vercel Secret for Production and Preview, then redeploy.
# Leave empty until the ANU account and paid API key are active.
ANU_QRNG_API_KEY=
# Optional provider override. ANU is skipped automatically without a key.
QRNG_PROVIDERS=anu,lfdr,qrandom,anu_legacy

# Optional anonymous usage metrics. Defaults on only in Vercel production.
# Operational QRNG/reading health logs are emitted regardless of this switch.
ORACLE_ANALYTICS_ENABLED=0
# Optional durable analytics; leave blank to use runtime logs only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
