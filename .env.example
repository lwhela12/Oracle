GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Astrology uses the bundled independent JPL engine. Install requirements.txt.
# Set to 1 to make birth charts and horoscopes available.
ORACLE_ASTROLOGY_ENABLED=0
ORACLE_ASTROLOGY_BACKEND=jpl
# Optional override; the kernel must match the pinned DE440s checksum.
# ORACLE_JPL_KERNEL_PATH=astrology/jpl/data/de440s.bsp

# ANU Quantum Numbers: paid subscription billed through AWS Marketplace.
# Set as a Vercel Secret for Production and Preview, then redeploy.
# Leave empty until the ANU account and paid API key are active.
ANU_QRNG_API_KEY=
# Optional provider override. ANU is skipped automatically without a key.
QRNG_PROVIDERS=anu,lfdr,qrandom,anu_legacy

# Optional anonymous usage metrics. Defaults on only in Vercel production.
# Operational QRNG/reading health logs are emitted regardless of this switch.
ORACLE_ANALYTICS_ENABLED=0
# Optional durable analytics; leave blank to use runtime logs only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# PostgreSQL operational collection: disabled until a URL is explicitly supplied.
# Use a scoped telemetry LOGIN, never the Railway bootstrap/admin credentials.
# Network URLs need numeric hostaddr alongside the TLS hostname; see docs/DATABASE_SETUP.md.
ORACLE_DATABASE_URL=
# Must match VERCEL_ENV exactly: production, preview, development; or local off Vercel.
ORACLE_DATABASE_ENVIRONMENT=local
# Classification is server-controlled; never accept this value from request JSON.
ORACLE_TRAFFIC_CLASS=public
# Migration credential is used only by explicit local/release commands, not Flask.
ORACLE_MIGRATION_DATABASE_URL=

# Scoped read-only reporting credential; separate from the telemetry writer.
ORACLE_REPORT_DATABASE_URL=

# Private owner dashboard: configure a Google OAuth Web application.
# Register exactly ORACLE_ADMIN_ORIGIN + /admin/auth/callback with Google.
ORACLE_ADMIN_ORIGIN=
ORACLE_ADMIN_GOOGLE_CLIENT_ID=
ORACLE_ADMIN_GOOGLE_CLIENT_SECRET=
# Generate a unique random secret of at least 32 characters; never reuse API keys.
ORACLE_ADMIN_SESSION_SECRET=
# Immutable Google subject IDs, comma-separated. Empty means no authorized owner.
# Sign in once to view your verified subject; adding an email does not grant access.
ORACLE_ADMIN_GOOGLE_SUBJECTS=
# Optional enrollment display guard only; email never grants owner access.
ORACLE_ADMIN_EXPECTED_EMAIL=
# Development only: allows http://127.0.0.1:<port> off Vercel; never disables auth.
ORACLE_ADMIN_LOCAL_HTTP=0
