{
  "version": 2,
  "build": {
    "env": {
      "VERCEL_PYTHON_DISABLE_RUNTIME_INSTALL": "1"
    }
  },
  "builds": [
    {
      "src": "static/**/*.{css,html,js,json,md,png,svg,txt,webp,xml}",
      "use": "@vercel/static"
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/static/robots.txt",
      "methods": ["GET", "HEAD"]
    },
    {
      "src": "/sitemap.xml",
      "dest": "/static/sitemap.xml",
      "methods": ["GET", "HEAD"]
    },
    {
      "src": "/$",
      "dest": "/static/index.html",
      "methods": ["GET", "HEAD"]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
